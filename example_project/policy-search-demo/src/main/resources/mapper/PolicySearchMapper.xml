<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    =====================================================================
    [MyBatis Mapper XML] 증권조회 SQL 매퍼
    =====================================================================
    namespace: com.hanwha.ax.mapper.PolicySearchMapper
    대상 테이블: TB_POLICY (증권 기본), TB_CUSTOMER (고객 기본)

    SQL 목록:
      - selectPolicyList  : 증권 목록 조회 (동적 WHERE 조건)
      - selectPolicyDetail: 증권 단건 상세 조회
    =====================================================================
-->
<mapper namespace="com.hanwha.ax.mapper.PolicySearchMapper">

    <!-- ================================================================
         ResultMap: 조회 결과 컬럼 → VO 필드 매핑
         ================================================================ -->
    <resultMap id="policyResultMap" type="com.hanwha.ax.vo.PolicySearchResultVO">
        <result column="POLICY_NO"           property="policyNo"/>
        <result column="PRODUCT_NAME"        property="productName"/>
        <result column="PRODUCT_CODE"        property="productCode"/>
        <result column="CUSTOMER_NAME"       property="customerName"/>
        <result column="CUSTOMER_RRN"        property="customerRrnMasked"/>
        <result column="CONTRACT_DATE"       property="contractDate"/>
        <result column="START_DATE"          property="startDate"/>
        <result column="END_DATE"            property="endDate"/>
        <result column="CONTRACT_PERIOD"     property="contractPeriod"/>
        <result column="MONTHLY_PREMIUM"     property="monthlyPremium"/>
        <result column="COVERAGE_AMOUNT"     property="coverageAmount"/>
        <result column="PAYMENT_CYCLE"       property="paymentCycle"/>
        <result column="PAYMENT_METHOD"      property="paymentMethod"/>
        <result column="CONTRACT_STATUS"     property="contractStatus"/>
        <result column="CONTRACT_STATUS_CD"  property="contractStatusCode"/>
        <result column="AGENT_NAME"          property="agentName"/>
        <result column="BRANCH_NAME"         property="branchName"/>
        <result column="TOTAL_COUNT"         property="totalCount"/>
    </resultMap>

    <!-- ================================================================
         SQL Fragment: 공통 SELECT 컬럼
         ================================================================ -->
    <sql id="policySelectColumns">
        P.POLICY_NO,
        P.PRODUCT_NAME,
        P.PRODUCT_CODE,
        C.CUSTOMER_NAME,
        C.CUSTOMER_RRN,
        TO_CHAR(P.CONTRACT_DATE, 'YYYY-MM-DD')  AS CONTRACT_DATE,
        TO_CHAR(P.START_DATE,    'YYYY-MM-DD')  AS START_DATE,
        TO_CHAR(P.END_DATE,      'YYYY-MM-DD')  AS END_DATE,
        P.CONTRACT_PERIOD,
        P.MONTHLY_PREMIUM,
        P.COVERAGE_AMOUNT,
        P.PAYMENT_CYCLE,
        P.PAYMENT_METHOD,
        P.CONTRACT_STATUS,
        P.CONTRACT_STATUS_CD,
        P.AGENT_NAME,
        P.BRANCH_NAME
    </sql>

    <!-- ================================================================
         selectPolicyList: 증권 목록 조회
         - 조회조건: 증권번호(부분일치), 고객명(부분일치), 주민번호(전체일치)
         - 동적 WHERE: <where> / <if> 태그로 조건 없을 시 전체 조회
         ================================================================ -->
    <select id="selectPolicyList" parameterType="com.hanwha.ax.vo.PolicySearchVO"
            resultMap="policyResultMap">
        SELECT
            <include refid="policySelectColumns"/>,
            COUNT(*) OVER() AS TOTAL_COUNT
        FROM TB_POLICY P
        INNER JOIN TB_CUSTOMER C
            ON P.CUSTOMER_ID = C.CUSTOMER_ID
        <where>
            <!-- 증권번호 조건: 부분 일치 (LIKE) -->
            <if test="policyNo != null and policyNo != ''">
                AND P.POLICY_NO LIKE '%' || #{policyNo} || '%'
            </if>
            <!-- 고객명 조건: 부분 일치 (LIKE) -->
            <if test="customerName != null and customerName != ''">
                AND C.CUSTOMER_NAME LIKE '%' || #{customerName} || '%'
            </if>
            <!-- 주민번호 조건: 전체 일치 (개인정보 보호) -->
            <if test="customerRrn != null and customerRrn != ''">
                AND C.CUSTOMER_RRN = #{customerRrn}
            </if>
        </where>
        ORDER BY P.CONTRACT_DATE DESC, P.POLICY_NO ASC
        LIMIT #{pageSize} OFFSET (#{pageNo} - 1) * #{pageSize}
    </select>

    <!-- ================================================================
         selectPolicyDetail: 증권 단건 상세 조회
         - 조회조건: 증권번호 (PK)
         ================================================================ -->
    <select id="selectPolicyDetail" parameterType="String"
            resultMap="policyResultMap">
        SELECT
            <include refid="policySelectColumns"/>,
            0 AS TOTAL_COUNT
        FROM TB_POLICY P
        INNER JOIN TB_CUSTOMER C
            ON P.CUSTOMER_ID = C.CUSTOMER_ID
        WHERE P.POLICY_NO = #{policyNo}
    </select>

</mapper>
